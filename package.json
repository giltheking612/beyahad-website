{
  "name": "beyahad-website",
  "version": "1.0.0",
  "private": true,
  "description": "אתר הנחיתה של התנועה האזרחית \"ביחד נתקן\" — אתר סטטי מבוסס Tailwind CSS.",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.17"
  }
}
